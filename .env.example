# Choose one: openrouter | wandb
LLM_PROVIDER=openrouter

# Optional: override the default model for the chosen provider.
# OpenRouter model ids look like "deepseek/deepseek-chat-v3.1", "google/gemini-2.5-pro", etc.
# W&B Inference model ids look like "meta-llama/Llama-3.1-8B-Instruct", "deepseek-ai/DeepSeek-V3.1".
# LLM_MODEL=

# --- OpenRouter ---
OPENROUTER_API_KEY=

# --- W&B Inference ---
WANDB_API_KEY=
WANDB_PROJECT=your-team/your-project
